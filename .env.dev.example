# dev configuration. Copy to .env.dev in the backend root and fill in values.
# Replace database hosts and credentials before starting.
APP_ENV=dev
ATLAS_DB_URL=jdbc:postgresql://replace-dev-db-host:5432/staticdb?sslmode=require
ATLAS_DB_PASSWORD=replace-with-dev-password
MARKETPLACE_DB_URL=jdbc:postgresql://replace-dev-db-host:5432/bizdb?sslmode=require
MARKETPLACE_DB_PASSWORD=replace-with-dev-password
CONCIERGE_DB_URL=jdbc:postgresql://replace-dev-db-host:5432/conciergedb?sslmode=require
CONCIERGE_DB_PASSWORD=replace-with-dev-password
# Spring reads this file as Java properties: KEY=value, without surrounding quotes.
# Use forward slashes in paths. Escape literal backslashes as \\.
ATLAS_PORT=8083
MARKETPLACE_PORT=8082
CONCIERGE_PORT=8081
ATLAS_DB_USERNAME=staticdb_app
MARKETPLACE_DB_USERNAME=bizdb_app
CONCIERGE_DB_USERNAME=concierge_app
ATLAS_BASE_URL=http://127.0.0.1:8083
MARKETPLACE_BASE_URL=http://127.0.0.1:8082
ATLAS_CORS_ALLOWED_ORIGINS=https://milobroker.com,https://www.milobroker.com,http://localhost:5173,http://127.0.0.1:4173
META_MODEL_ENABLED=false
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MESSAGING_ACCOUNT_ID=1057188817349490
WHATSAPP_ONBOARDING_FLOW_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
# PEM newlines can be represented by literal \n sequences on one line.
FLOW_PRIVATE_KEY_PEM=
META_APP_SECRET=
INTERNAL_DELETION_SECRET=
META_MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
META_MODEL_NAME=
MEDIA_BUCKET=
AWS_REGION=ap-southeast-2
MEDIA_ENDPOINT=
MEDIA_PRESIGN_MINUTES=15
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
