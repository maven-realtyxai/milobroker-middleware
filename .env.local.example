# local configuration. Copy to .env.local in the backend root and fill in values.
# Uses the EC2 database tunnel on port 5433; for Docker Postgres use 5432 and milobroker-local passwords.
APP_ENV=local
ATLAS_DB_URL=jdbc:postgresql://127.0.0.1:5433/staticdb
ATLAS_DB_PASSWORD=replace-with-your-ssm-password
MARKETPLACE_DB_URL=jdbc:postgresql://127.0.0.1:5433/bizdb
MARKETPLACE_DB_PASSWORD=replace-with-your-ssm-password
CONCIERGE_DB_URL=jdbc:postgresql://127.0.0.1:5433/conciergedb
CONCIERGE_DB_PASSWORD=replace-with-your-ssm-password
# Spring reads this file as Java properties: KEY=value, without surrounding quotes.
# Use forward slashes in paths. Escape literal backslashes as \\.
ATLAS_PORT=8083
MARKETPLACE_PORT=8082
CONCIERGE_PORT=8081
ATLAS_DB_USERNAME=staticdb_app
MARKETPLACE_DB_USERNAME=bizdb_app
CONCIERGE_DB_USERNAME=concierge_app
ATLAS_BASE_URL=http://127.0.0.1:8083
MARKETPLACE_BASE_URL=http://127.0.0.1:8082
ATLAS_CORS_ALLOWED_ORIGINS=https://milobroker.com,https://www.milobroker.com,http://localhost:5173,http://127.0.0.1:4173
META_MODEL_ENABLED=false
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ONBOARDING_FLOW_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
# PEM newlines can be represented by literal \n sequences on one line.
FLOW_PRIVATE_KEY_PEM=
